# Python bytecode from running installer/build.py or the engine
__pycache__/
*.pyc

# payload/executors.toml is only the source of the adopter seed (build.py comments
# out its cheap-route block); it is never live here. This repo's live executor-tier
# config is the host's workflow/executors.toml, one folder above this repo
# (../workflow/executors.toml), so a sync-agents run there never touches the
# tracked sources under payload/.
